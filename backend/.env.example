NODE_ENV=development
PORT=8080
DATABASE_URL=postgresql://user:password@localhost:5432/redes_db?schema=public
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
JWT_EXPIRATION=86400000
CORS_ORIGINS=http://localhost:5173
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Accounts created by the seed (npm run seed). The passwords are read from the environment and
# never stored in the repository: write them in backend/.env, which is not versioned.
ADMIN_USERNAME=pasmarc079
ADMIN_EMAIL=pasmarc079@ministerioredes.org
ADMIN_PASSWORD=
EDITOR_USERNAME=editor
EDITOR_EMAIL=editor@ministerioredes.com
EDITOR_PASSWORD=

# Contact email (where form submissions are sent)
CONTACT_EMAIL=

# SMTP (optional — defaults to console log in dev if not set)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Google reviews (Places API). Leave empty to hide the reviews block.
# Create the key in Google Cloud, restrict it to the Places API, and keep it secret.
GOOGLE_API_KEY=
GOOGLE_PLACE_ID=ChIJeV3XD5gjKI4RfXuRyfvpieY
# Only reviews with this rating or higher are shown (1-5). Google returns at most 5 reviews per place.
GOOGLE_REVIEWS_MIN_RATING=4
GOOGLE_REVIEWS_LIMIT=5

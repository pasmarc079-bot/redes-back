generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  EDITOR
  EVENT_MANAGER
  COMMUNITY_MANAGER
  VIEWER
}

enum BadgeType {
  VOLUNTEER
  LEADER
  ATTENDANCE
  SERVICE
  SPECIAL
  MILESTONE
}

enum EventStatus {
  DRAFT
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model User {
  id           String       @id @default(uuid())
  username     String       @unique @db.VarChar(50)
  email        String       @unique
  passwordHash String       @map("password_hash")
  firstName    String?      @map("first_name") @db.VarChar(100)
  lastName     String?      @map("last_name") @db.VarChar(100)
  avatarUrl    String?      @map("avatar_url")
  isActive     Boolean      @default(true) @map("is_active")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  roles        UserRoleEnum[]
  member       Member?
  createdEvents Event[]     @relation("EventCreator")
  createdBadges MemberBadge[] @relation("BadgeAssigner")
  authoredPosts BlogPost[]  @relation("PostAuthor")
  uploadedMedia  Media[]    @relation("MediaUploader")

  @@map("users")
}

model UserRoleEnum {
  id     String   @id @default(uuid())
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String   @map("user_id")
  role   UserRole

  @@unique([userId, role])
  @@map("user_roles")
}

model Member {
  id          String        @id @default(uuid())
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String        @unique @map("user_id")
  phone       String?       @db.VarChar(20)
  bio         String?       @db.Text
  joinDate    DateTime?     @map("join_date") @db.Date
  groupName   String?       @map("group_name") @db.VarChar(100)
  status      String?       @db.VarChar(20)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  badges      MemberBadge[]

  @@map("members")
}

model Badge {
  id          String        @id @default(uuid())
  name        String        @db.VarChar(100)
  slug        String        @unique @db.VarChar(120)
  description String?       @db.Text
  iconUrl     String?       @map("icon_url")
  type        BadgeType
  color       String?       @db.VarChar(7)
  criteria    String?       @db.Text
  isActive    Boolean       @default(true) @map("is_active")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  members     MemberBadge[]

  @@map("badges")
}

model MemberBadge {
  id          String    @id @default(uuid())
  member      Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId    String    @map("member_id")
  badge       Badge     @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  badgeId     String    @map("badge_id")
  awardedDate DateTime  @default(now()) @map("awarded_date")
  notes       String?   @db.Text
  createdBy   User?     @relation("BadgeAssigner", fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?   @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([memberId, badgeId])
  @@map("member_badges")
}

model Event {
  id             String      @id @default(uuid())
  title          String      @db.VarChar(200)
  slug           String      @unique @db.VarChar(220)
  description    String?     @db.Text
  shortDescription String?   @map("short_description") @db.VarChar(500)
  startDate      DateTime    @map("start_date")
  endDate        DateTime?   @map("end_date")
  location       String?     @db.VarChar(200)
  address        String?     @db.Text
  latitude       Decimal?    @db.Decimal(10, 7)
  longitude      Decimal?    @db.Decimal(10, 7)
  flyerUrl       String?     @map("flyer_url")
  gallery        Json?
  status         EventStatus @default(DRAFT)
  isFeatured     Boolean     @default(false) @map("is_featured")
  capacity       Int?
  registrationUrl String?    @map("registration_url")
  createdBy      User?       @relation("EventCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdById    String?     @map("created_by")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  @@map("events")
}

model BlogPost {
  id             String     @id @default(uuid())
  title          String     @db.VarChar(300)
  slug           String     @unique @db.VarChar(320)
  content        String     @db.Text
  excerpt        String?    @db.VarChar(500)
  coverImageUrl  String?    @map("cover_image_url")
  author         User       @relation("PostAuthor", fields: [authorId], references: [id])
  authorId       String     @map("author_id")
  status         PostStatus @default(DRAFT)
  publishedAt    DateTime?  @map("published_at")
  readTime       Int?       @map("read_time")
  seoTitle       String?    @map("seo_title") @db.VarChar(200)
  seoDescription String?    @map("seo_description") @db.VarChar(300)
  ogImageUrl     String?    @map("og_image_url")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  tags           PostTag[]

  @@map("blog_posts")
}

model Tag {
  id        String    @id @default(uuid())
  name      String    @unique @db.VarChar(50)
  slug      String    @unique @db.VarChar(60)
  color     String?   @db.VarChar(7)

  posts     PostTag[]

  @@map("tags")
}

model PostTag {
  id     String   @id @default(uuid())
  post   BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId String   @map("post_id")
  tag    Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId  String   @map("tag_id")

  @@unique([postId, tagId])
  @@map("post_tags")
}

model Media {
  id           String   @id @default(uuid())
  originalUrl  String   @map("original_url")
  thumbnailUrl String?  @map("thumbnail_url")
  mediumUrl    String?  @map("medium_url")
  fileName     String   @map("file_name")
  mimeType     String   @map("mime_type")
  fileSize     BigInt   @map("file_size")
  width        Int?
  height       Int?
  altText      String?  @map("alt_text") @db.VarChar(200)
  uploadedBy   User?    @relation("MediaUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  uploadedById String?  @map("uploaded_by")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("media")
}

model SocialConfig {
  id         String   @id @default(uuid())
  platform   String   @db.VarChar(30)
  accountUrl String?  @map("account_url")
  feedUrl    String?  @map("feed_url")
  apiToken   String?  @map("api_token") @db.Text
  isActive   Boolean  @default(true) @map("is_active")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([platform])
  @@map("social_configs")
}

model SiteSetting {
  id        String   @id @default(uuid())
  key       String   @unique @db.VarChar(100)
  value     String   @db.Text
  label     String?  @db.VarChar(200)
  group     String   @default("general") @db.VarChar(50)
  type      String   @default("text") @db.VarChar(30)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

model MenuItem {
  id        String     @id @default(uuid())
  label     String     @db.VarChar(100)
  url       String     @db.VarChar(500)
  order     Int        @default(0)
  isActive  Boolean    @default(true) @map("is_active")
  parent    MenuItem?  @relation("MenuParent", fields: [parentId], references: [id], onDelete: SetNull)
  parentId  String?    @map("parent_id")
  children  MenuItem[] @relation("MenuParent")
  location  String     @default("header") @db.VarChar(30)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@map("menu_items")
}

model PageContent {
  id        String   @id @default(uuid())
  key       String   @unique @db.VarChar(100)
  title     String?  @db.VarChar(300)
  body      String?  @db.Text
  section   String   @db.VarChar(50)
  order     Int      @default(0)
  imageUrl  String?  @map("image_url")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("page_contents")
}

model ServiceSchedule {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(100)
  dayOfWeek   String   @map("day_of_week") @db.VarChar(20)
  time        String   @db.VarChar(20)
  description String?  @db.VarChar(300)
  order       Int      @default(0)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("service_schedules")
}
